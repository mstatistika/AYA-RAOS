:root {
  --aya-red: #9f1f1f;
  --aya-red-dark: #721414;
  --aya-red-soft: #f7e6e2;
  --aya-gold: #b98a3a;
  --aya-gold-soft: #ead7ad;
  --aya-ivory: #fffdf8;
  --aya-cream: #f8f1e7;
  --aya-cream-deep: #efe2d1;
  --aya-ink: #241b18;
  --aya-copy: #625650;
  --aya-muted: #887a72;
  --aya-line: rgba(77, 52, 42, 0.13);
  --aya-shadow: 0 24px 70px rgba(86, 47, 33, 0.10);
  --aya-shadow-soft: 0 12px 36px rgba(86, 47, 33, 0.07);
  --aya-radius-lg: 28px;
  --aya-radius-md: 20px;
  --aya-radius-sm: 13px;
  --aya-container: min(1180px, calc(100% - 40px));
  --aya-header-height: 78px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--aya-ink);
  background: var(--aya-ivory);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
body.menu-open,
body.drawer-open { overflow: hidden; }
img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
button { color: inherit; }
.container { width: var(--aya-container); margin-inline: auto; }
.section { padding: 92px 0; }
.section-sm { padding: 64px 0; }
.page-shell { min-height: calc(100vh - 160px); }
.skip-link {
  position: fixed;
  z-index: 9999;
  top: -70px;
  left: 16px;
  padding: 10px 16px;
  border-radius: 10px;
  color: #fff;
  background: var(--aya-red-dark);
}
.skip-link:focus { top: 16px; }

h1, h2, h3, h4, p { margin-top: 0; }
h1, h2, h3, h4 {
  margin-bottom: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 500;
  line-height: 1.08;
}
h1 { font-size: clamp(42px, 6vw, 76px); letter-spacing: -0.045em; }
h2 { font-size: clamp(33px, 4.2vw, 52px); letter-spacing: -0.035em; }
h3 { font-size: 25px; }
p { margin-bottom: 0; color: var(--aya-copy); }
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--aya-gold);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .18em;
  text-transform: uppercase;
}
.eyebrow::before {
  width: 24px;
  height: 1px;
  content: "";
  background: currentColor;
}
.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 38px;
}
.section-heading > div { max-width: 720px; }
.section-heading h2 { margin-top: 10px; }
.section-heading > p { max-width: 430px; }
.section-heading.centered {
  align-items: center;
  flex-direction: column;
  text-align: center;
}
.section-heading.centered > p { max-width: 650px; }

/* Header */
.site-header {
  position: sticky;
  z-index: 80;
  top: 0;
  border-bottom: 1px solid var(--aya-line);
  background: rgba(255, 253, 248, .94);
  backdrop-filter: blur(18px);
}
.site-header-inner {
  min-height: var(--aya-header-height);
  display: flex;
  align-items: center;
  gap: 26px;
}
.wordmark {
  display: inline-flex;
  min-width: 132px;
  flex-direction: column;
  color: var(--aya-red-dark);
  line-height: 1;
}
.wordmark strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 27px;
  font-weight: 500;
  letter-spacing: .08em;
}
.wordmark small {
  margin-top: 6px;
  color: var(--aya-gold);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .30em;
  text-transform: uppercase;
}
.primary-nav {
  display: flex;
  align-items: center;
  gap: 26px;
  margin-left: auto;
}
.primary-nav a {
  position: relative;
  padding: 8px 0;
  color: var(--aya-copy);
  font-size: 13px;
  font-weight: 700;
}
.primary-nav a::after {
  position: absolute;
  right: 0;
  bottom: 2px;
  left: 0;
  height: 1px;
  content: "";
  transform: scaleX(0);
  transform-origin: right;
  background: var(--aya-red);
  transition: transform .22s ease;
}
.primary-nav a:hover,
.primary-nav a[aria-current="page"] { color: var(--aya-red); }
.primary-nav a:hover::after,
.primary-nav a[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
.header-actions { display: flex; align-items: center; gap: 10px; }
.cart-link {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 0 15px;
  border: 1px solid var(--aya-line);
  border-radius: 999px;
  background: #fff;
  font-size: 12px;
  font-weight: 800;
}
.cart-count {
  min-width: 23px;
  height: 23px;
  display: inline-grid;
  place-items: center;
  padding-inline: 6px;
  border-radius: 999px;
  color: #fff;
  background: var(--aya-red);
  font-size: 11px;
}
.header-cta {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 18px;
  border-radius: 999px;
  color: #fff;
  background: var(--aya-red);
  font-size: 12px;
  font-weight: 800;
}
.header-cta:hover { background: var(--aya-red-dark); }
.menu-toggle {
  width: 44px;
  height: 44px;
  display: none;
  padding: 10px;
  border: 1px solid var(--aya-line);
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
}
.menu-toggle span { display: block; height: 2px; margin: 5px 0; background: var(--aya-ink); }
.mobile-panel { display: none; }

/* Buttons */
.button {
  min-height: 50px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 0 22px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  transition: transform .2s ease, background .2s ease, border-color .2s ease;
}
.button:hover { transform: translateY(-2px); }
.button-primary { color: #fff; background: var(--aya-red); box-shadow: 0 12px 28px rgba(159, 31, 31, .16); }
.button-primary:hover { background: var(--aya-red-dark); }
.button-secondary { border-color: var(--aya-line); background: rgba(255,255,255,.72); }
.button-secondary:hover { border-color: var(--aya-gold); }
.button-text { min-height: auto; padding: 0; border-radius: 0; color: var(--aya-red); background: transparent; }
.button-full { width: 100%; }
.text-link { color: var(--aya-red); font-size: 13px; font-weight: 800; }

/* Homepage hero */
.hero {
  position: relative;
  overflow: hidden;
  padding: 72px 0 76px;
  background:
    radial-gradient(circle at 10% 20%, rgba(185,138,58,.09), transparent 26%),
    linear-gradient(120deg, #fffdf8 0%, #fbf6ed 55%, #f4e8db 100%);
}
.hero::after {
  position: absolute;
  top: 0;
  right: 0;
  width: 42%;
  height: 100%;
  content: "";
  opacity: .28;
  background-image: radial-gradient(var(--aya-gold) .55px, transparent .55px);
  background-size: 18px 18px;
  mask-image: linear-gradient(to left, #000, transparent);
}
.hero-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: .92fr 1.08fr;
  align-items: center;
  gap: 74px;
}
.hero-copy h1 { max-width: 660px; margin-top: 16px; color: var(--aya-red-dark); }
.hero-copy > p { max-width: 590px; margin-top: 22px; font-size: 17px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 34px; }
.hero-meta span { color: var(--aya-muted); font-size: 12px; }
.hero-meta strong { display: block; color: var(--aya-ink); font-size: 13px; }
.hero-visual { position: relative; }
.hero-frame {
  position: relative;
  overflow: hidden;
  min-height: 520px;
  border-radius: 44px 44px 18px 18px;
  background: var(--aya-cream-deep);
  box-shadow: var(--aya-shadow);
}
.hero-frame img { width: 100%; height: 100%; min-height: 520px; object-fit: cover; object-position: center; }
.hero-seal {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 122px;
  height: 122px;
  display: grid;
  place-items: center;
  padding: 15px;
  border: 1px solid rgba(255,255,255,.72);
  border-radius: 50%;
  color: #fff;
  background: rgba(150, 103, 30, .88);
  box-shadow: 0 12px 30px rgba(53,32,16,.16);
  text-align: center;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 14px;
  line-height: 1.25;
}
.hero-caption {
  position: absolute;
  right: 24px;
  bottom: 22px;
  left: 24px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 20px;
  border: 1px solid rgba(255,255,255,.5);
  border-radius: 17px;
  color: #fff;
  background: rgba(62, 25, 20, .74);
  backdrop-filter: blur(12px);
}
.hero-caption small, .hero-caption strong { display: block; }
.hero-caption small { color: #ead5b1; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
.hero-caption strong { margin-top: 4px; font-family: Georgia, "Times New Roman", serif; font-size: 22px; }
.hero-caption span { max-width: 210px; color: rgba(255,255,255,.78); font-size: 12px; text-align: right; }

/* Three lines */
.lines-section { background: var(--aya-ivory); }
.lines-title {
  margin-bottom: 34px;
  text-align: center;
}
.lines-title span { color: var(--aya-copy); font-size: 11px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; }
.lines-title h2 { margin-top: 7px; color: var(--aya-gold); font-size: clamp(31px, 4vw, 47px); }
.lines-title p { max-width: 620px; margin: 13px auto 0; }
.line-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.line-card {
  overflow: hidden;
  border: 1px solid var(--aya-line);
  border-radius: var(--aya-radius-md);
  background: #fff;
  box-shadow: var(--aya-shadow-soft);
}
.line-card-image { position: relative; overflow: hidden; aspect-ratio: 1.52; background: var(--aya-cream); }
.line-card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s ease; }
.line-card:hover .line-card-image img { transform: scale(1.035); }
.line-icon {
  position: absolute;
  right: 0;
  bottom: -23px;
  left: 0;
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  margin: auto;
  border: 3px solid #fff;
  border-radius: 50%;
  color: #fff;
  background: var(--aya-red);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 19px;
}
.line-card:nth-child(2) .line-icon { background: var(--aya-gold); }
.line-card-body { padding: 37px 24px 25px; text-align: center; }
.line-card-body h3 { color: var(--aya-red-dark); }
.line-card:nth-child(2) h3 { color: var(--aya-gold); }
.line-card-body p { min-height: 50px; margin-top: 9px; font-size: 13px; }
.line-card-body .text-link { display: inline-block; margin-top: 17px; }

/* Brand story strip */
.story-strip {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  align-items: center;
  gap: 38px;
  padding: 34px 38px;
  border: 1px solid var(--aya-line);
  border-radius: var(--aya-radius-md);
  background:
    linear-gradient(90deg, rgba(255,253,248,.96), rgba(248,241,231,.9)),
    radial-gradient(circle at 15% 10%, rgba(185,138,58,.16), transparent 36%);
}
.story-strip h2 { color: var(--aya-red-dark); font-size: clamp(29px, 3.3vw, 43px); }
.story-strip p { max-width: 630px; }

/* Testimonials */
.testimonials-home { background: #fbf6ef; }
.testimonial-video-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.video-stage,
.video-empty {
  position: relative;
  min-height: 360px;
  overflow: hidden;
  border-radius: var(--aya-radius-lg);
  background: #251713;
  box-shadow: var(--aya-shadow-soft);
}
.video-stage video { width: 100%; height: 100%; min-height: 360px; object-fit: cover; }
.video-empty {
  display: grid;
  place-items: center;
  padding: 38px;
  color: #fff;
  background:
    linear-gradient(135deg, rgba(50,22,18,.92), rgba(114,20,20,.76)),
    url('../assets/images/sambal.webp') center/cover;
  text-align: center;
}
.play-symbol {
  width: 68px;
  height: 68px;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  border: 1px solid rgba(255,255,255,.58);
  border-radius: 50%;
  color: #fff;
  background: rgba(255,255,255,.12);
  font-size: 21px;
}
.video-empty h3 { font-size: 31px; }
.video-empty p { max-width: 420px; margin: 12px auto 0; color: rgba(255,255,255,.75); }
.video-note {
  padding: 35px;
  border: 1px solid var(--aya-line);
  border-radius: var(--aya-radius-lg);
  background: #fff;
}
.video-note h3 { color: var(--aya-red-dark); font-size: 34px; }
.video-note p { margin-top: 14px; }
.video-note .button { margin-top: 23px; }
.big-picture-testimonial {
  position: relative;
  overflow: hidden;
  min-height: 510px;
  margin-top: 22px;
  border-radius: var(--aya-radius-lg);
  background: var(--aya-cream-deep);
  box-shadow: var(--aya-shadow-soft);
}
.big-picture-testimonial img { width: 100%; height: 510px; object-fit: cover; object-position: center 44%; }
.big-picture-testimonial::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(90deg, rgba(37,17,13,.82) 0%, rgba(37,17,13,.46) 48%, rgba(37,17,13,.08) 100%);
}
.big-picture-copy {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: clamp(28px, 6vw, 76px);
  max-width: 520px;
  transform: translateY(-50%);
  color: #fff;
}
.big-picture-copy span { color: var(--aya-gold-soft); font-size: 11px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
.big-picture-copy blockquote {
  margin: 18px 0 20px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(35px, 5vw, 61px);
  line-height: 1.08;
}
.big-picture-copy strong { display: block; font-size: 14px; }
.big-picture-copy small { color: rgba(255,255,255,.72); }
.text-testimonial-block { margin-top: 24px; }
.testimonial-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 14px; }
.testimonial-toolbar h3 { color: var(--aya-red-dark); }
.carousel-controls { display: flex; gap: 8px; }
.carousel-control {
  width: 40px;
  height: 40px;
  border: 1px solid var(--aya-line);
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
}
.text-carousel {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  padding: 4px 2px 14px;
  scroll-behavior: smooth;
  scrollbar-width: none;
  scroll-snap-type: x mandatory;
}
.text-carousel::-webkit-scrollbar { display: none; }
.text-testimonial {
  min-width: min(380px, 86vw);
  scroll-snap-align: start;
  padding: 25px;
  border: 1px solid var(--aya-line);
  border-radius: 18px;
  background: #fff;
}
.text-testimonial p { color: var(--aya-ink); font-family: Georgia, "Times New Roman", serif; font-size: 20px; line-height: 1.45; }
.text-testimonial footer { margin-top: 20px; }
.text-testimonial strong, .text-testimonial span { display: block; }
.text-testimonial strong { color: var(--aya-red); font-size: 13px; }
.text-testimonial span { color: var(--aya-muted); font-size: 12px; }

/* CTA */
.cta-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 34px 40px;
  border-radius: var(--aya-radius-md);
  color: #fff;
  background:
    linear-gradient(105deg, rgba(114,20,20,.98), rgba(159,31,31,.94)),
    radial-gradient(circle at 85% 15%, rgba(255,255,255,.12), transparent 35%);
  box-shadow: 0 18px 45px rgba(114,20,20,.18);
}
.cta-banner h2 { max-width: 730px; color: #fff; font-size: clamp(29px, 3.5vw, 44px); }
.cta-banner p { margin-top: 10px; color: rgba(255,255,255,.72); }
.cta-banner .button { flex: 0 0 auto; color: var(--aya-red-dark); background: #fff; }

/* Footer */
.site-footer {
  padding: 66px 0 0;
  border-top: 1px solid var(--aya-line);
  background: #fbf6ef;
}
.footer-grid { display: grid; grid-template-columns: 1.35fr repeat(3, .7fr); gap: 46px; }
.footer-brand p { max-width: 350px; margin-top: 18px; font-size: 13px; }
.footer-column { display: flex; flex-direction: column; gap: 9px; }
.footer-column h3 {
  margin-bottom: 8px;
  color: var(--aya-red-dark);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .13em;
  text-transform: uppercase;
}
.footer-column a, .footer-column span, .footer-column button {
  padding: 0;
  border: 0;
  color: var(--aya-copy);
  background: transparent;
  text-align: left;
  font-size: 13px;
  cursor: pointer;
}
.footer-column a:hover, .footer-column button:hover { color: var(--aya-red); }
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 50px;
  padding: 18px 0;
  border-top: 1px solid var(--aya-line);
  color: var(--aya-muted);
  font-size: 11px;
}
.footer-accent { height: 7px; background: linear-gradient(90deg, var(--aya-red-dark), var(--aya-red), var(--aya-gold)); }

/* Generic page hero */
.page-hero { padding: 66px 0 54px; border-bottom: 1px solid var(--aya-line); background: linear-gradient(120deg, #fffdf8, #f8f1e7); }
.page-hero-grid { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 40px; }
.page-hero h1 { max-width: 830px; margin-top: 12px; color: var(--aya-red-dark); font-size: clamp(40px, 5.5vw, 68px); }
.page-hero p { max-width: 680px; margin-top: 18px; }
.breadcrumb { display: flex; flex-wrap: wrap; gap: 8px; color: var(--aya-muted); font-size: 12px; }
.breadcrumb a:hover { color: var(--aya-red); }

/* Catalog */
.catalog-toolbar {
  position: sticky;
  z-index: 20;
  top: calc(var(--aya-header-height) + 12px);
  display: grid;
  grid-template-columns: minmax(220px, 1fr) auto;
  gap: 14px;
  margin-bottom: 26px;
  padding: 14px;
  border: 1px solid var(--aya-line);
  border-radius: 18px;
  background: rgba(255,253,248,.94);
  box-shadow: var(--aya-shadow-soft);
  backdrop-filter: blur(14px);
}
.search-field { position: relative; }
.search-field input {
  width: 100%;
  min-height: 46px;
  padding: 0 16px 0 42px;
  border: 1px solid var(--aya-line);
  border-radius: 999px;
  background: #fff;
}
.search-field::before { position: absolute; top: 11px; left: 16px; content: "⌕"; color: var(--aya-muted); font-size: 19px; }
.filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; }
.filter-chip {
  min-height: 42px;
  padding: 0 14px;
  border: 1px solid var(--aya-line);
  border-radius: 999px;
  background: #fff;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}
.filter-chip.active, .filter-chip:hover { color: #fff; border-color: var(--aya-red); background: var(--aya-red); }
.catalog-meta { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
.catalog-meta span { color: var(--aya-muted); font-size: 12px; }
.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.product-card {
  display: flex;
  overflow: hidden;
  flex-direction: column;
  border: 1px solid var(--aya-line);
  border-radius: var(--aya-radius-md);
  background: #fff;
  box-shadow: var(--aya-shadow-soft);
}
.product-image-link { position: relative; overflow: hidden; aspect-ratio: 1.25; background: var(--aya-cream); }
.product-image-link img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.product-card:hover .product-image-link img { transform: scale(1.035); }
.product-placeholder { width: 100%; height: 100%; display: grid; place-items: center; padding: 24px; color: var(--aya-red-dark); background: linear-gradient(135deg, #f8f1e7, #ead7c3); text-align: center; font-family: Georgia, "Times New Roman", serif; font-size: 28px; }
.product-badge {
  position: absolute;
  top: 13px;
  left: 13px;
  padding: 7px 10px;
  border-radius: 999px;
  color: var(--aya-red-dark);
  background: rgba(255,253,248,.92);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .09em;
  text-transform: uppercase;
}
.product-card-body { display: flex; flex: 1; flex-direction: column; padding: 20px; }
.product-line { color: var(--aya-gold); font-size: 10px; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
.product-card h3 { margin-top: 5px; color: var(--aya-red-dark); font-size: 24px; }
.product-card-description { margin-top: 9px; font-size: 13px; }
.product-card-footer { display: flex; align-items: end; justify-content: space-between; gap: 14px; margin-top: auto; padding-top: 20px; }
.product-price-label { color: var(--aya-muted); font-size: 10px; }
.product-price { display: block; color: var(--aya-red); font-weight: 900; }
.product-quick-add {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  border: 0;
  border-radius: 50%;
  color: #fff;
  background: var(--aya-red);
  cursor: pointer;
  font-size: 20px;
}
.product-quick-add:hover { background: var(--aya-red-dark); }
.empty-state { padding: 70px 30px; border: 1px dashed var(--aya-line); border-radius: var(--aya-radius-md); text-align: center; }
.empty-state h3 { color: var(--aya-red-dark); }
.empty-state p { margin-top: 10px; }

/* Product detail */
.product-detail-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 66px; align-items: start; }
.product-gallery-main { overflow: hidden; border-radius: var(--aya-radius-lg); background: var(--aya-cream); box-shadow: var(--aya-shadow-soft); }
.product-gallery-main img { width: 100%; aspect-ratio: 1.08; object-fit: cover; }
.product-detail-copy { position: sticky; top: calc(var(--aya-header-height) + 30px); }
.product-detail-copy h1 { margin-top: 8px; color: var(--aya-red-dark); font-size: clamp(39px, 5vw, 62px); }
.product-detail-lead { margin-top: 18px; font-size: 16px; }
.detail-price { margin-top: 22px; color: var(--aya-red); font-size: 24px; font-weight: 900; }
.purchase-box { margin-top: 24px; padding: 22px; border: 1px solid var(--aya-line); border-radius: 18px; background: #fff; box-shadow: var(--aya-shadow-soft); }
.form-field { display: grid; gap: 7px; }
.form-field + .form-field { margin-top: 15px; }
.form-field label { color: var(--aya-ink); font-size: 12px; font-weight: 800; }
.form-field input, .form-field select, .form-field textarea {
  width: 100%;
  min-height: 46px;
  padding: 10px 13px;
  border: 1px solid var(--aya-line);
  border-radius: 12px;
  background: #fff;
}
.form-field textarea { min-height: 120px; resize: vertical; }
.purchase-row { display: grid; grid-template-columns: 1fr 90px; gap: 10px; }
.purchase-box .button { margin-top: 16px; }
.detail-facts { display: grid; gap: 1px; margin-top: 30px; overflow: hidden; border: 1px solid var(--aya-line); border-radius: 16px; background: var(--aya-line); }
.detail-fact { display: grid; grid-template-columns: 145px 1fr; gap: 16px; padding: 16px; background: #fff; }
.detail-fact strong { font-size: 12px; }
.detail-fact span { color: var(--aya-copy); font-size: 13px; }

/* Cart page */
.cart-layout { display: grid; grid-template-columns: 1fr 370px; gap: 30px; align-items: start; }
.cart-list { overflow: hidden; border: 1px solid var(--aya-line); border-radius: var(--aya-radius-md); background: #fff; }
.cart-row { display: grid; grid-template-columns: 90px 1fr auto; gap: 18px; padding: 20px; border-bottom: 1px solid var(--aya-line); }
.cart-row:last-child { border-bottom: 0; }
.cart-row img, .cart-row-placeholder { width: 90px; height: 90px; border-radius: 14px; object-fit: cover; background: var(--aya-cream); }
.cart-row-placeholder { display: grid; place-items: center; color: var(--aya-red); font-family: Georgia, "Times New Roman", serif; }
.cart-row h3 { color: var(--aya-red-dark); font-size: 21px; }
.cart-row p { margin-top: 5px; font-size: 12px; }
.quantity-control { display: inline-flex; align-items: center; gap: 10px; margin-top: 12px; }
.quantity-control button { width: 30px; height: 30px; border: 1px solid var(--aya-line); border-radius: 9px; background: #fff; cursor: pointer; }
.remove-link { display: block; margin-top: 9px; padding: 0; border: 0; color: var(--aya-red); background: transparent; font-size: 11px; cursor: pointer; }
.cart-row-price { white-space: nowrap; font-size: 13px; font-weight: 900; }
.order-summary { position: sticky; top: calc(var(--aya-header-height) + 30px); padding: 24px; border: 1px solid var(--aya-line); border-radius: var(--aya-radius-md); background: var(--aya-cream); }
.order-summary h2 { color: var(--aya-red-dark); font-size: 31px; }
.summary-line { display: flex; justify-content: space-between; gap: 20px; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--aya-line); }
.summary-line strong { color: var(--aya-red); font-size: 20px; }
.summary-note { margin-top: 9px; font-size: 11px; }
.order-summary .button { margin-top: 18px; }

/* Testimonial page and form */
.testimonial-form-grid { display: grid; grid-template-columns: .78fr 1.22fr; gap: 46px; align-items: start; }
.form-intro { position: sticky; top: calc(var(--aya-header-height) + 28px); }
.form-intro h2 { margin-top: 10px; color: var(--aya-red-dark); }
.form-intro p { margin-top: 16px; }
.approval-steps { display: grid; gap: 11px; margin-top: 24px; }
.approval-step { display: grid; grid-template-columns: 34px 1fr; gap: 12px; align-items: start; }
.approval-step span { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; color: var(--aya-red); background: var(--aya-red-soft); font-weight: 900; }
.approval-step strong { display: block; font-size: 13px; }
.approval-step small { color: var(--aya-muted); }
.form-card { padding: 28px; border: 1px solid var(--aya-line); border-radius: var(--aya-radius-lg); background: #fff; box-shadow: var(--aya-shadow-soft); }
.form-grid-two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.checkbox-field { display: grid; grid-template-columns: 20px 1fr; gap: 10px; margin-top: 17px; align-items: start; }
.checkbox-field input { margin-top: 3px; }
.checkbox-field label { color: var(--aya-copy); font-size: 12px; }
.form-status { display: none; margin-top: 16px; padding: 13px 15px; border-radius: 12px; font-size: 13px; }
.form-status.show { display: block; }
.form-status.success { color: #285d36; background: #e7f4e9; }
.form-status.error { color: #83251f; background: #f8e5e2; }

/* Information page */
.info-grid { display: grid; grid-template-columns: 240px 1fr; gap: 50px; }
.info-nav { position: sticky; top: calc(var(--aya-header-height) + 28px); display: grid; gap: 6px; align-self: start; }
.info-nav a { padding: 11px 13px; border-radius: 10px; color: var(--aya-copy); font-size: 13px; font-weight: 700; }
.info-nav a:hover { color: var(--aya-red); background: var(--aya-red-soft); }
.info-content { display: grid; gap: 26px; }
.info-card { padding: 28px; border: 1px solid var(--aya-line); border-radius: var(--aya-radius-md); background: #fff; }
.info-card h2 { color: var(--aya-red-dark); font-size: 34px; }
.info-card p, .info-card li { color: var(--aya-copy); }
.info-card p { margin-top: 13px; }
.info-card ul { margin: 14px 0 0; padding-left: 20px; }

/* Drawer / quick add */
.drawer-backdrop { position: fixed; z-index: 110; inset: 0; background: rgba(36,27,24,.52); backdrop-filter: blur(5px); }
.quick-drawer {
  position: fixed;
  z-index: 120;
  right: 0;
  bottom: 0;
  width: min(480px, 100%);
  max-height: 92dvh;
  overflow-y: auto;
  transform: translateX(105%);
  border-radius: 24px 0 0 0;
  background: var(--aya-ivory);
  box-shadow: -20px 0 60px rgba(36,27,24,.2);
  transition: transform .25s ease;
}
.quick-drawer.open { transform: translateX(0); }
.drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px; border-bottom: 1px solid var(--aya-line); }
.drawer-head h2 { color: var(--aya-red-dark); font-size: 30px; }
.drawer-close { width: 40px; height: 40px; border: 1px solid var(--aya-line); border-radius: 50%; background: #fff; cursor: pointer; font-size: 21px; }
.drawer-content { padding: 22px; }
.drawer-product { display: grid; grid-template-columns: 90px 1fr; gap: 15px; }
.drawer-product img, .drawer-product-placeholder { width: 90px; height: 90px; border-radius: 14px; object-fit: cover; background: var(--aya-cream); }
.drawer-product-placeholder { display: grid; place-items: center; color: var(--aya-red); }
.drawer-product h3 { color: var(--aya-red-dark); }
.drawer-actions { display: grid; gap: 10px; margin-top: 18px; }
.toast {
  position: fixed;
  z-index: 140;
  bottom: 24px;
  left: 50%;
  padding: 11px 16px;
  transform: translate(-50%, 24px);
  opacity: 0;
  pointer-events: none;
  border-radius: 999px;
  color: #fff;
  background: var(--aya-ink);
  font-size: 12px;
  transition: .22s ease;
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }

/* Responsive */
@media (max-width: 980px) {
  :root { --aya-container: min(760px, calc(100% - 32px)); }
  .section { padding: 76px 0; }
  .primary-nav, .header-cta { display: none; }
  .menu-toggle { display: block; }
  .mobile-panel {
    position: fixed;
    z-index: 75;
    inset: var(--aya-header-height) 0 0;
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 26px 24px;
    transform: translateY(-115%);
    background: var(--aya-ivory);
    transition: transform .25s ease;
  }
  .mobile-panel.open { transform: translateY(0); }
  .mobile-panel a { padding: 14px 4px; border-bottom: 1px solid var(--aya-line); font-family: Georgia, "Times New Roman", serif; font-size: 27px; }
  .hero-grid, .product-detail-grid, .cart-layout, .testimonial-form-grid { grid-template-columns: 1fr; }
  .hero-grid { gap: 44px; }
  .hero-copy { text-align: center; }
  .hero-copy > p { margin-inline: auto; }
  .hero-actions, .hero-meta { justify-content: center; }
  .hero-frame { min-height: 500px; }
  .line-grid, .product-grid { grid-template-columns: repeat(2, 1fr); }
  .story-strip { grid-template-columns: 1fr; }
  .testimonial-video-grid { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: repeat(3, 1fr); }
  .footer-brand { grid-column: 1 / -1; }
  .product-detail-copy, .order-summary, .form-intro { position: static; }
  .info-grid { grid-template-columns: 1fr; }
  .info-nav { position: static; display: flex; overflow-x: auto; }
  .info-nav a { white-space: nowrap; }
}

@media (max-width: 680px) {
  :root {
    --aya-container: calc(100% - 28px);
    --aya-header-height: 68px;
    --aya-radius-lg: 23px;
  }
  .section { padding: 62px 0; }
  .section-sm { padding: 48px 0; }
  .site-header-inner { min-height: var(--aya-header-height); }
  .wordmark strong { font-size: 23px; }
  .wordmark small { font-size: 8px; }
  .cart-link { width: 44px; padding: 0; justify-content: center; }
  .cart-link > span:first-child { display: none; }
  .hero { padding: 50px 0 58px; }
  .hero-copy { text-align: left; }
  .hero-actions { justify-content: stretch; }
  .hero-actions .button { flex: 1; padding-inline: 14px; }
  .hero-meta { justify-content: flex-start; gap: 17px; }
  .hero-frame, .hero-frame img { min-height: 420px; }
  .hero-seal { width: 98px; height: 98px; font-size: 12px; }
  .hero-caption { right: 13px; bottom: 13px; left: 13px; padding: 14px; }
  .hero-caption span { display: none; }
  .section-heading { align-items: start; flex-direction: column; gap: 15px; }
  .line-grid, .product-grid { grid-template-columns: 1fr; }
  .line-card-body p { min-height: auto; }
  .story-strip { padding: 27px 23px; }
  .big-picture-testimonial, .big-picture-testimonial img { min-height: 460px; height: 460px; }
  .big-picture-testimonial::after { background: linear-gradient(to top, rgba(37,17,13,.86), rgba(37,17,13,.08)); }
  .big-picture-copy { top: auto; right: 25px; bottom: 34px; left: 25px; transform: none; }
  .cta-banner { align-items: flex-start; flex-direction: column; padding: 28px 24px; }
  .cta-banner .button { width: 100%; }
  .footer-grid { grid-template-columns: repeat(2, 1fr); gap: 34px 20px; }
  .footer-brand { grid-column: 1 / -1; }
  .footer-bottom { align-items: flex-start; flex-direction: column; }
  .page-hero-grid { grid-template-columns: 1fr; }
  .catalog-toolbar { position: static; grid-template-columns: 1fr; }
  .filter-row { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
  .filter-chip { white-space: nowrap; }
  .catalog-meta { align-items: flex-start; flex-direction: column; }
  .product-gallery-main img { aspect-ratio: 1; }
  .purchase-row { grid-template-columns: 1fr 82px; }
  .detail-fact { grid-template-columns: 1fr; gap: 5px; }
  .cart-row { grid-template-columns: 72px 1fr; }
  .cart-row img, .cart-row-placeholder { width: 72px; height: 72px; }
  .cart-row-price { grid-column: 2; }
  .form-grid-two { grid-template-columns: 1fr; }
  .quick-drawer { border-radius: 24px 24px 0 0; }
  .toast { bottom: 16px; max-width: calc(100% - 30px); white-space: nowrap; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
}

.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  overflow: hidden !important;
  clip: rect(0,0,0,0) !important;
  white-space: nowrap !important;
}
